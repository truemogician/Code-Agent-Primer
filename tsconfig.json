{
	"include": [
		"src/**/*"
	],
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"strict": true,
		"noImplicitOverride": true,
		"outDir": "./dist",
		"rootDir": "./src"
	}
}