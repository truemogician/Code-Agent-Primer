{
	"include": [
		"src/**/*",
		"tests/**/*"
	],
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["bun"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"strict": true,
		"noImplicitOverride": true,
		"rootDir": "./",
		"outDir": "./dist",
	}
}